{
  "name": "marktab",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "MarkTab 3 — a fast, private, keyboard-first bookmark new tab for Chrome and Edge.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:scripts",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "validate": "node scripts/validate-release.mjs",
    "package": "node scripts/package-release.mjs",
    "release:check": "npm run typecheck && npm test && npm run build && npm run validate && npm run package",
    "screenshots": "node scripts/capture-store-assets.mjs",
    "cws:publish": "node scripts/cws-publish.mjs",
    "edge:publish": "node scripts/edge-publish.mjs",
    "bump": "node scripts/bump-version.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "axe-core": "^4.14.0",
    "happy-dom": "^21.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
